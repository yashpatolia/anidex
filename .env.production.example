# Lives on the VPS as `.env` next to docker-compose.yml (not committed).
# GitHub Actions does NOT manage this file — set it up once on the server.

IMAGE=ghcr.io/<your-github-username>/anime-list:latest

POSTGRES_USER=anime_list
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=anime_list

NEXTAUTH_URL=https://your-domain.example
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Sign-in is AniList OAuth only. Register an API Client at
# https://anilist.co/settings/developer with Redirect URL
# https://your-domain.example/api/auth/callback/anilist
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# For "import by MAL username" (src/app/import). Register a (Non-Commercial)
# app at https://myanimelist.net/apiconfig — only the Client ID is needed.
MAL_CLIENT_ID=
