// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js (NextAuth) models ---
// https://authjs.dev/getting-started/adapters/prisma

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Only set for credentials (email/password) accounts. Null for OAuth-only users.
  passwordHash  String?

  accounts  Account[]
  sessions  Session[]
  listEntries AnimeListEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App models ---

enum WatchStatus {
  WATCHING
  COMPLETED
  PLANNED
  DROPPED
  PAUSED
  REWATCHING
}

// A user's entry for one anime. Anime metadata itself (title, cover art,
// episode count, etc.) is NOT stored here — it's fetched live from the
// AniList API by anilistId and cached client-side/CDN-side, not in our DB.
model AnimeListEntry {
  id        String      @id @default(cuid())
  userId    String
  anilistId Int
  status    WatchStatus @default(PLANNED)
  score     Int? // 1-10, null = unscored
  progress  Int         @default(0) // episodes watched
  notes     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, anilistId])
  @@index([userId, status])
}
