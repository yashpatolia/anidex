// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js (NextAuth) models ---
// https://authjs.dev/getting-started/adapters/prisma

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Only set for credentials (email/password) accounts. Null for OAuth-only users.
  passwordHash  String?

  // Public handle, >=4 chars, [a-z0-9_] (see src/lib/username.ts). Nullable
  // only because this column was added after some users already existed —
  // every row is backfilled with a generated one (see
  // prisma/backfill-usernames.ts), so application code can treat it as
  // always present. New signups (credentials or OAuth) always get one
  // immediately, so it never goes null again after the one-time backfill.
  username             String?  @unique
  // True until the user changes it away from what was auto-generated
  // (backfill, or a new Google sign-up) — drives the one-time "pick your
  // own" nudge on Account settings.
  usernameAutoAssigned Boolean  @default(false)

  // Profile customization.
  bio          String?
  // A user-uploaded profile picture, stored inline as a data URL (this app
  // has no blob/file storage — see the banner picker's own comment in
  // profile-prefs.ts for the same constraint). Resized/compressed
  // client-side before upload, so this stays small; validated again
  // server-side in src/app/api/account/avatar/route.ts. Takes priority
  // over `image` (the OAuth-provided picture) when rendering — see
  // src/lib/profile-access.ts. Null falls back to `image`, and then to a
  // generated initial avatar if that's null too.
  avatarImage  String?  @db.Text
  // Shape: ProfilePrefs from src/lib/profile-prefs.ts (accent color, section
  // visibility/order, which stats show). Free-form JSON so it can evolve
  // without a migration each time.
  profilePrefs Json?

  accounts      Account[]
  sessions      Session[]
  listEntries   AnimeListEntry[]
  notifications Notification[]
  // Rows where this user is the one doing the following / being followed.
  // See Follow below for why these are two separate relations on one model.
  following     Follow[]         @relation("Following")
  followers     Follow[]         @relation("Followers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App models ---

enum WatchStatus {
  WATCHING
  COMPLETED
  PLANNED
  DROPPED
  PAUSED
  REWATCHING
}

// Read-through cache of AniList metadata, keyed by their media id. Populated
// lazily: the first request for a given anime fetches from AniList and stores
// it here; every later request (from any user) is served from this table
// until it goes stale. See src/lib/anime-cache.ts.
// A user's entry for one anime. Anime metadata itself (title, cover art,
// episode count, etc.) is never stored server-side at all anymore — every
// page that needs it fetches AniList live, from the browser, per request.
// See src/lib/anilist-client.ts's file comment: this app used to have an
// AnimeCache table here doing exactly that server-side, which AniList's
// own developers confirmed counts as "hoarding" under their ToS.
model AnimeListEntry {
  id        String      @id @default(cuid())
  userId    String
  anilistId Int
  status    WatchStatus @default(PLANNED)
  score     Int? // 1-10, null = unscored
  progress  Int         @default(0) // episodes watched
  notes     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, anilistId])
  @@index([userId, status])
}

// Generated lazily, not by a scheduled job (this app doesn't have a task
// scheduler yet — see ROADMAP.md's separate "Scheduled jobs" line): when a
// signed-in user opens the notification bell, the server checks their
// Watching/Rewatching list against AniList's airing data and inserts a row
// here for any episode that's aired since they last had one generated,
// then returns the list. The unique constraint below is what makes that
// safe to re-run on every open — re-checking never creates a duplicate for
// an episode already notified.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  anilistId Int
  episode   Int
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, anilistId, episode])
  @@index([userId, read])
}

// One row per follow relationship. Restricted at the application layer
// (src/lib/follows.ts) to targets with a public profile — a private
// profile has no page to follow *from*, so this table never needs to
// distinguish "private" from "doesn't exist" the way findPublicUser does.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
}
