# Copy to .env for local development (not committed).

DATABASE_URL="postgresql://anime_list:anime_list_dev_pw@localhost:5432/anime_list?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-secret-change-me"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# For the "import by MAL username" option (src/app/import). Only a Client ID
# is needed — reading a *public* MAL list doesn't require full OAuth, just
# this header. Register a (Non-Commercial) app at https://myanimelist.net/apiconfig
MAL_CLIENT_ID=""

# Dev-only credentials login (seeded by prisma/seed.ts), never used in production
DEV_LOGIN_EMAIL="dev@example.com"
DEV_LOGIN_PASSWORD="devpassword"
